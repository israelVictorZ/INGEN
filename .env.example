# Copie para .env e preencha. NUNCA commite o .env.

# Neon Postgres (pooled para o app; unpooled para migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Riot Games API: usada SÓ pelo script local `npm run sync` (nunca na Vercel)
RIOT_API_KEY=
RIOT_PLATFORM=br1
RIOT_REGION=americas
SYNC_MATCH_COUNT=15

# URL pública do site (usada em metadados e no texto do scouting)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twitch (pausado; ver docs/roadmap.md)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
